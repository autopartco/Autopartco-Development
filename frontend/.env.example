# Entorno LOCAL del frontend. Copia este archivo a `.env.local` (git lo ignora) y ajusta.
# Todas las variables VITE_* son PÚBLICAS: terminan en el bundle del navegador. Nunca pongas secretos aquí.
# Vite solo las lee al arrancar: reinicia `npm run dev` después de cambiarlas.
#
# Archivos por ambiente (cada uno tiene su ejemplo; ver docs/deploy/ENVIRONMENTS.md):
#   .env.example             local (este)         -> npm run dev
#   .env.demo.example        demo con backend+BD  -> npm run dev:demo / npm run build:demo
#   .env.production.example  producción           -> npm run build:prod

# Origen de datos de TODA la app.
#   mock : datos simulados en memoria, sin backend (por defecto).
#   http : backend real (catálogo, cuentas, direcciones, checkout...).
VITE_MARKETPLACE_DATA_SOURCE=mock

# URL base de la API con el prefijo de versión (ApiPaths.BASE = /api/v1). Solo se usa con "http".
# El backend escucha en 8081 por defecto (SERVER_PORT) y solo acepta peticiones del frontend en
# http://localhost:5173 y http://localhost:5174 (CORS).
VITE_API_BASE_URL=http://localhost:8081/api/v1
