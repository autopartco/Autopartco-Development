# Entorno de PRODUCCIÓN del frontend. Estas variables se fijan en el BUILD (`npm run build:prod`):
# no se pueden cambiar después sin volver a construir. Cárgalas como variables del pipeline de
# despliegue (CI) o en `.env.production.local` (git lo ignora); NO subas el valor real al repo.
# Variables VITE_* = PÚBLICAS (terminan en el bundle). Nunca pongas secretos aquí.
#
# El build de producción FALLA si no se cumple esto (vite.config.ts):
#   - VITE_MARKETPLACE_DATA_SOURCE debe ser "http" (nunca datos simulados en producción).
#   - VITE_API_BASE_URL debe ser una URL https:// absoluta.

VITE_MARKETPLACE_DATA_SOURCE=http

# API pública de producción, con el prefijo de versión. El dominio del frontend debe estar en
# APP_CORS_ALLOWED_ORIGINS del backend (backend/.env.production.example).
VITE_API_BASE_URL=https://api.example.com/api/v1
