# Entorno DEMO del frontend: la app contra el backend y la base de datos reales de demostración.
# Copia a `.env.demo.local` (git lo ignora; Vite lo carga con --mode demo) y ajusta.
# Variables VITE_* = PÚBLICAS (terminan en el bundle). Nunca pongas secretos aquí.
#
# Arranque:   npm run dev:demo      (puerto 5174, el que admite el CORS del backend)
# Build:      npm run build:demo    (genera dist/ con estas variables)
# Backend:    perfil Spring `dev` o `demo` con SPRING_PROFILES_ACTIVE (ver backend/.env.demo.example)

VITE_MARKETPLACE_DATA_SOURCE=http

# Backend de demostración. En local: http://localhost:8081/api/v1
# En un servidor de demo: https://api-demo.<tu-dominio>/api/v1
VITE_API_BASE_URL=http://localhost:8081/api/v1
