# Entorno LOCAL del backend. Copia este archivo a `backend/.env` (git lo ignora) y completa los valores.
# NUNCA subas valores reales. Los nombres de variable coinciden con application.yaml.
#
# Archivos por ambiente (cada uno tiene su ejemplo; ver docs/deploy/ENVIRONMENTS.md):
#   .env.example             local (este)
#   .env.demo.example        demo con backend + BD de demostración
#   .env.production.example  producción

# Perfil de Spring: `dev` en local y demo; `prod` en producción (application-prod.yaml).
SPRING_PROFILES_ACTIVE=dev

# --- Base de datos (PostgreSQL 16+) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autopartco
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-database-password

# --- Supabase (almacenamiento de imágenes y documentos) ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Clave de servicio: solo backend, jamás en el frontend. (También se acepta SUPABASE_SECRET_KEY.)
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWKS_URL=https://xxxxxx.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_PRODUCTS_IMGS=name-bucket
SUPABASE_BUCKET_BUSINESS=bussniess

# --- Firma de tokens JWT (par RSA) ---
# En local se lee del classpath (backend/src/main/resources/certs/, ignorado por git).
# En demo y producción apunta a archivos montados en el servidor: file:/run/secrets/jwt-public.pem
RSA_PUBLIC_KEY_PATH=classpath:certs/pub.pem
RSA_PRIVATE_KEY_PATH=classpath:certs/pri.pem

# --- Servidor y URLs ---
SERVER_PORT=8081
APP_PUBLIC_BASE_URL=http://localhost:8081
APP_FRONTEND_BASE_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
PASSWORD_RECOVERY_EXPIRES_MINUTES=15
ACCESS_TOKEN_EXPIRES_MINUTES=5
REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Correo (verificación de cuenta, recuperación de contraseña) ---
# En local puedes usar un SMTP de pruebas (Mailpit/MailHog en el puerto 1025) en vez de uno real.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=no-reply@autopartco.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# --- Wompi (suscripciones de almacenes). Usa llaves de SANDBOX en local y demo ---
WOMPI_PUBLIC_KEY=your-wompi-public-key
WOMPI_INTEGRITY_SECRET=replace-with-wompi-integrity-secret
WOMPI_EVENTS_SECRET=replace-with-wompi-events-secret
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_REDIRECT_URL=http://localhost:5173/seller/payment-result

# --- Checkout del marketplace ---
# Pagos simulados (POST /marketplace/orders con simulatedOutcome). true en local y demo.
APP_CHECKOUT_SIMULATED_PAYMENTS_ENABLED=true

# Cobro simulado de suscripciones (sin pasarela). true SOLO en local y demo; en produccion debe ser false.
SIMULATED_PAYMENTS_ENABLED=false
