# Entorno de PRODUCCIÓN del backend. Estas variables se inyectan en el servidor (gestor de secretos,
# variables del orquestador o un `.env` con permisos 600 fuera del repositorio). NUNCA subas valores reales.
# Requiere `SPRING_PROFILES_ACTIVE=prod` (application-prod.yaml: ddl-auto none, CORS explícito, sin trazas).
# Antes de desplegar: docs/deploy/ENVIRONMENTS.md (lista de verificación de producción).

SPRING_PROFILES_ACTIVE=prod

DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=autopartco
DB_USERNAME=autopartco_app
# Usuario de aplicación con los privilegios mínimos (sin superusuario). Respaldos automáticos activados.
DB_PASSWORD=replace-with-production-database-password

SUPABASE_URL=https://production-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-production-supabase-publishable-key
SUPABASE_SERVICE_KEY=your-production-supabase-service-role-key
SUPABASE_JWKS_URL=https://production-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_PRODUCTS_IMGS=products-images
SUPABASE_BUCKET_BUSINESS=business

# Par RSA EXCLUSIVO de producción (no reutilices el de local ni el de demo), montado como archivos.
# Generación: openssl genrsa -out jwt-private.pem 2048 ; openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
# (el private debe estar en PKCS#8: openssl pkcs8 -topk8 -nocrypt -in ... -out ...)
RSA_PUBLIC_KEY_PATH=file:/run/secrets/jwt-public.pem
RSA_PRIVATE_KEY_PATH=file:/run/secrets/jwt-private.pem

SERVER_PORT=8081
# URL pública de la API (la usan los enlaces de los correos y las redirecciones).
APP_PUBLIC_BASE_URL=https://api.example.com
# URL pública del frontend (enlaces de verificación y recuperación de contraseña).
APP_FRONTEND_BASE_URL=https://www.example.com
# Orígenes del frontend autorizados por CORS, separados por comas. Obligatorio en prod; sin comodines.
APP_CORS_ALLOWED_ORIGINS=https://www.example.com
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
PASSWORD_RECOVERY_EXPIRES_MINUTES=15
ACCESS_TOKEN_EXPIRES_MINUTES=5
REFRESH_TOKEN_EXPIRES_DAYS=30

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-production-mail-username
MAIL_PASSWORD=replace-with-production-mail-password
MAIL_FROM=no-reply@autopartco.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# Wompi: llaves de producción SOLO cuando exista la decisión comercial y de cumplimiento (blueprint §9.4).
# Mientras tanto usa las de sandbox.
WOMPI_PUBLIC_KEY=pub_prod_replace-me
WOMPI_INTEGRITY_SECRET=prod_integrity_replace-me
WOMPI_EVENTS_SECRET=prod_events_replace-me
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_REDIRECT_URL=https://www.example.com/seller/payment-result

# Pagos simulados. Decisión vigente (2026-10-14): se mantienen activos para la demo publicada en main.
# Pasar a false ANTES de aceptar pedidos de clientes reales (riesgo 2 de docs/architecture/2026-10-14-mvp-checkout-plan.md).
APP_CHECKOUT_SIMULATED_PAYMENTS_ENABLED=true

# Cookie del refresh token (sesión persistente). Usar true solo con HTTPS.
AUTH_COOKIE_SECURE=true
