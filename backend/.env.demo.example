# Entorno DEMO del backend: la app completa con una base de datos de demostración (datos de prueba).
# Copia a `backend/.env` en el servidor de demo (o inyecta las variables). NUNCA subas valores reales.
# Para demo en la propia máquina basta con `backend/.env.example` y el perfil `dev`.
#
# Reglas del ambiente demo:
#   - Base de datos APARTE de la de producción (nunca compartas credenciales ni datos).
#   - Llaves de Wompi de SANDBOX y SMTP de pruebas o limitado a destinatarios de confianza.
#   - Pagos simulados activos: el frontend muestra "Demostración: no se hace ningún cobro real".

SPRING_PROFILES_ACTIVE=dev

DB_HOST=db-demo.example.com
DB_PORT=5432
DB_NAME=autopartco_demo
DB_USERNAME=autopartco_demo
DB_PASSWORD=replace-with-demo-database-password

SUPABASE_URL=https://demo-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-demo-supabase-publishable-key
SUPABASE_SERVICE_KEY=your-demo-supabase-service-role-key
SUPABASE_JWKS_URL=https://demo-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_PRODUCTS_IMGS=products-images-demo
SUPABASE_BUCKET_BUSINESS=business-demo

# Par RSA propio de demo (distinto al de producción), montado como archivos.
RSA_PUBLIC_KEY_PATH=file:/run/secrets/demo-jwt-public.pem
RSA_PRIVATE_KEY_PATH=file:/run/secrets/demo-jwt-private.pem

SERVER_PORT=8081
APP_PUBLIC_BASE_URL=https://api-demo.example.com
APP_FRONTEND_BASE_URL=https://demo.example.com
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
PASSWORD_RECOVERY_EXPIRES_MINUTES=15
ACCESS_TOKEN_EXPIRES_MINUTES=5
REFRESH_TOKEN_EXPIRES_DAYS=30

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-demo-mail-username
MAIL_PASSWORD=replace-with-demo-mail-password
MAIL_FROM=demo@autopartco.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# SANDBOX de Wompi.
WOMPI_PUBLIC_KEY=pub_test_replace-me
WOMPI_INTEGRITY_SECRET=test_integrity_replace-me
WOMPI_EVENTS_SECRET=test_events_replace-me
WOMPI_CHECKOUT_URL=https://checkout.wompi.co/p/
WOMPI_REDIRECT_URL=https://demo.example.com/seller/payment-result

APP_CHECKOUT_SIMULATED_PAYMENTS_ENABLED=true

# Cookie del refresh token (sesión persistente). Usar true solo con HTTPS.
AUTH_COOKIE_SECURE=false
