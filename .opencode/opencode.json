{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "permission": {
    "edit": {
      "*": "allow",
      ".opencode/*": "ask",
      "AGENTS.md": "ask",
      ".github/*": "ask",
      ".claude/*": "ask",
      "*.env.example": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "graphify-out/*": "deny",
      "backend/bin/*": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "ask",
      "*.key": "ask",
      "*.p12": "ask",
      "*.jks": "ask"
    },
    "bash": {
      "*": "ask",
      "graphify query *": "allow",
      "graphify path *": "allow",
      "graphify explain *": "allow",
      "graphify update .": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git rev-parse *": "allow",
      "git ls-files*": "allow",
      "pwd": "allow",
      "ls*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Location": "allow",
      "*BackendApplicationTests*": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask"
  },
  "agent": {
    "explore": {
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "graphify query *": "allow",
          "graphify path *": "allow",
          "graphify explain *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show *": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          "~/.opencode/plan/*": "allow"
        }
      }
    }
  }
}
