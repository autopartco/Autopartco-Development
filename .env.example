# Plantilla del único .env de Autopartco. Cópiala a `.env` en la raíz del repo y completa los valores.
# NUNCA subas valores reales. Lo leen:
#   - backend:  cd backend && mvn spring-boot:run   (application.yaml importa ../.env)
#   - frontend: cd frontend && npm run dev          (vite.config.ts usa envDir '..')
# Corre la app como en producción (perfil prod, backend real) pero contra la BD local.
# Las variables VITE_* son públicas (terminan en el navegador): nunca pongas secretos con ese prefijo.

# --- Perfil ---
SPRING_PROFILES_ACTIVE=prod

# --- Base de datos local ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=autopartco
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-database-password

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_JWKS_URL=https://xxxxx.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_BUCKET_PRODUCTS_IMGS=products-images
SUPABASE_BUCKET_BUSINESS=business

# --- Firma JWT ---
RSA_PUBLIC_KEY_PATH=classpath:certs/pub.pem
RSA_PRIVATE_KEY_PATH=classpath:certs/pri.pem

# --- Servidor, URLs y CORS ---
SERVER_PORT=8081
APP_PUBLIC_BASE_URL=http://localhost:8081
APP_FRONTEND_BASE_URL=http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En local no hay HTTPS: la cookie del refresh token no puede ser Secure.
AUTH_COOKIE_SECURE=false
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
ACCESS_TOKEN_EXPIRES_MINUTES=5
REFRESH_TOKEN_EXPIRES_DAYS=30
PASSWORD_RECOVERY_EXPIRES_MINUTES=15

# --- Correo ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-mail-username
MAIL_PASSWORD=replace-with-mail-password
MAIL_FROM=no-reply@autopartco.com
MAIL_AUTH=true
MAIL_STARTTLS=true

# --- Pagos (sandbox / simulados) ---
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_REDIRECT_URL=http://localhost:5173/portal/pago/resultado
APP_CHECKOUT_SIMULATED_PAYMENTS_ENABLED=true
SIMULATED_PAYMENTS_ENABLED=true

# --- Frontend (Vite) ---
VITE_MARKETPLACE_DATA_SOURCE=http
VITE_API_BASE_URL=http://localhost:8081/api/v1
# Correo público de ventas para el plan Empresarial («Hablar con ventas»). Vacío: no se muestra el botón.
VITE_SALES_EMAIL=
